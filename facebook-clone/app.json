{
  "expo": {
    "name": "Facebook Demo",
    "slug": "facebook-clone-demo",
    "version": "1.0.0",
    "scheme": "facebook-demo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "demo.hackathon.facebookclone"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Common Ground uses your location once, when you check in at a meetup."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Common Ground reads when you're busy (never what your events are) and adds plans you join to a Common Ground calendar."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a friend's code to confirm you met.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
