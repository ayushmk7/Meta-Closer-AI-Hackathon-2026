{
  "name": "facebook-clone-demo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "test:native": "jest --runInBand",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.33",
    "expo-asset": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.6",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.24",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-notifications"
      ]
    }
  }
}
