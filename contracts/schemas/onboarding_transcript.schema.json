{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onboarding_transcript.schema.json",
  "title": "One line of data/seed/<poolId>/onboarding.jsonl (simulated onboarding chat)",
  "type": "object",
  "required": ["userId", "turns"],
  "additionalProperties": false,
  "properties": {
    "userId": { "$ref": "common.schema.json#/$defs/userId" },
    "turns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "additionalProperties": false,
        "properties": { "role": { "enum": ["muse", "user"] }, "text": { "type": "string" } }
      }
    }
  }
}
