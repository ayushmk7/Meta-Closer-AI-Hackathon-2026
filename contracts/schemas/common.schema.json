{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "userId": { "type": "string", "pattern": "^u_[a-z0-9]+$" },
    "poolId": { "type": "string", "pattern": "^pool_[a-z0-9_]+$" },
    "interestId": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,2}$" },
    "latLng": {
      "type": "object",
      "required": ["lat", "lng"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "availabilitySlot": {
      "type": "object",
      "required": ["day", "part"],
      "additionalProperties": false,
      "properties": {
        "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
        "part": { "enum": ["morning", "afternoon", "evening"] }
      }
    },
    "groupSize": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 2 },
        "max": { "type": "integer", "minimum": 2 }
      }
    },
    "ageBand": { "enum": ["18_21", "22_25", "26_29", "30_34"] },
    "mode": { "enum": ["city", "event", "campus", "group", "arriving", "cohort"] }
  }
}
