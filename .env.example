# Copy to .env (services) and copy the EXPO_PUBLIC_* lines to facebook-clone/.env (app).
# Names are fixed by contracts/CONTRACTS.md §12. Never commit a filled-in .env.

# Shared
DEMO_MODE=1
MODEL_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_FAKE=0
LAYA_URL=http://127.0.0.1:8090
LAYA_MODEL=laya
LAYA_FAKE=0
CG_DATA_DIR=./data
CG_CONTRACTS_DIR=./contracts

# Backend
CG_API_HOST=0.0.0.0
CG_API_PORT=8000
CG_INTERNAL_HOST=127.0.0.1
